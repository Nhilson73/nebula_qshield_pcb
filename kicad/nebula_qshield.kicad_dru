(version 1)


(rule "Signal_Default"
  (constraint track_width (min 0.2mm))
  (constraint clearance (min 0.2mm))
  (constraint via_diameter (min 0.5mm))
  (constraint hole_size (min 0.2mm))
  (constraint annular_width (min 0.15mm))
)

(rule "Power_Rails"
  (constraint track_width (min 0.5mm))
  (constraint clearance (min 0.25mm))
  (constraint via_diameter (min 0.5mm))
  (constraint hole_size (min 0.2mm))
  (constraint annular_width (min 0.15mm))
  (condition "A.NetClass == 'Power' && A.Type != 'pad'")
)

(rule "High_Current_12V"
  (constraint track_width (min 0.5mm))
  (constraint clearance (min 0.3mm))
  (constraint via_diameter (min 0.5mm))
  (constraint hole_size (min 0.2mm))
  (constraint annular_width (min 0.15mm))
  (condition "A.NetClass == 'HighCurrent' && A.Type != 'pad'")
)

(rule "Analog_Signals"
  (constraint track_width (min 0.25mm))
  (constraint clearance (min 0.3mm))
  (condition "A.NetClass == 'Analog' && A.Type != 'pad'")
)

(rule "I2C_Bus"
  (constraint track_width (min 0.25mm))
  (constraint clearance (min 0.25mm))
  (condition "A.NetClass == 'I2C' && A.Type != 'pad'")
)

(rule "Relay_HV_Contacts"
  (constraint track_width (min 1.0mm))
  (constraint clearance (min 0.5mm))
  (condition "A.NetClass == 'RelayHV' && A.Type != 'pad'")
)

(rule "Isolation_Barrier"
  (constraint clearance (min 0.3mm))
  (condition "A.NetClass == 'Analog' && B.NetClass == 'Power' && A.Type != 'pad' && B.Type != 'pad'")
)

(rule "Silk_to_Pad"
  (constraint silk_clearance (min 0.15mm))
)

(rule "Courtyard_Overlap"
  (constraint courtyard_clearance (min 0.25mm))
)

(rule "Board_Edge"
  (constraint edge_clearance (min 0.25mm))
  (condition "A.NetName != '/Power Management/VIN_12V'")
)

(rule "J1_Edge"
  (constraint edge_clearance (min -0.5mm))
  (condition "A.NetName == '/Power Management/VIN_12V'")
)


