  (text "HMI & CONNECTORS\nHMI via UART (D0/D1) — Nextion/Stone compatible\nShield header J21 connects to Arduino UNO Q\nDC input J17 on power_management sheet"
    (at 25.4 15.24 0)
    (effects (font (size 2.54 2.54)))
    (uuid "e9934e5b-d6eb-4828-b500-1e0f7d6e247a")
  )

  ;; =====================================================
  ;; HMI UART Connector (replaces HDMI + USB)
  ;; JST-XH 4-pin: VCC(5V) / TX / RX / GND
  ;; =====================================================
  (text "HMI DISPLAY — UART Interface\nJST-XH 4-pin: 5V / MCU_TX(D1) / MCU_RX(D0) / GND\nCompatible: Nextion, Stone, DWIN HMI panels\nProtection: TVS ESD on TX/RX lines"
    (at 25.4 30.48 0)
    (effects (font (size 1.524 1.524)))
    (uuid "3c4dfa67-2c63-47c8-8ae4-a58eb75b22da")
  )

